# Never commit your real .env. Public/private routing still needs HTTPS.
# npm run auth:setup creates the owner, protected key and enables authentication.
# Production and Docker require authentication by default; missing key/account fails closed.
# For local-only development, leave AUTH_MODE unset until setup. Never publicly deploy disabled auth.
AUTH_MODE=
AUTH_SECRET_KEY=
# Local setup writes false only for loopback development. Docker always uses Secure cookies.
AUTH_COOKIE_SECURE=true
LENEU_IMAGE=leneu-storage:local
LENEU_DATA_DIR=./data
LENEU_BACKUP_DIR=./backups
LENEU_PRIVATE_PORT=8787
LENEU_SHARE_PORT=8790

# Optional exact private HTTP(S) origins, comma-separated, without trailing slash.
# Set the private Tailscale HTTPS origin before using its reverse proxy. No CORS is enabled.
PRIVATE_ALLOWED_ORIGINS=

# Same Origin in both processes. Replace after the public domain is configured.
# Production: https://share.leneu.store (match deploy/Caddyfile.public)
PUBLIC_SHARE_ORIGIN=http://127.0.0.1:8790

# Server master switch: disabled stops all AI profiles, hive enables Hive + Devin selection.
# Configure keys/models first, then use AI_RUNNER_KIND=hive. No automatic fallback.
AI_RUNNER_KIND=disabled
AI_RUNNER_URL=
AI_RUNNER_TOKEN=
# Optional Devin CLI profile: install/login on the server, then select it per request.
AI_DEVIN_BIN=devin
AI_DEVIN_MODEL=swe-2-high
# Absolute path; blank reuses the installed CLI login. Never put the token here.
AI_DEVIN_CREDENTIALS_FILE=
OCR_RUNNER_URL=
OCR_RUNNER_TOKEN=
GOOGLE_MAPS_DEMO_KEY=

# Geoapify Static Maps: private server key. Never use a VITE_ prefix.
# Paste the API key after the equals sign; never commit the real .env.
GEOAPIFY_API_KEY=

# Hive Chat Completions (server-only; direct adapter implemented)
# Paste the Secret Key from Hive Service API Keys here.
# Set HIVE_MODEL to the model key enabled in your Hive account.
HIVE_API_KEY=
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=

# Independent static HTML/CSS/JS hosting; separate origin from the private app.
# Production: PUBLIC_SITES_ORIGIN=https://host.leneu.store
# Docker on Oracle: LENEU_SITES_DIR=/srv/leneu/sites
HOSTED_SITES_DIR=./hosted-sites
PUBLIC_SITES_ORIGIN=http://127.0.0.1:8792
SITES_HOST=127.0.0.1
SITES_PORT=8792
LENEU_SITES_DIR=./hosted-sites
LENEU_SITES_PORT=8792

# OpenCode CLI: enable only after installing/authenticating in the actual worker runtime
# and checking the selected provider terms. UI model catalog lives in private SQLite.
AI_OPENCODE_ENABLED=false
AI_OPENCODE_BIN=opencode
AI_OPENCODE_MODEL=
# Optional absolute auth.json path. Only the selected provider credential is copied per run.
AI_OPENCODE_AUTH_FILE=

# Private service Telegram alerts. No automatic retries; never pass to public servers.
SERVICE_TELEGRAM_ENABLED=false
SERVICE_TELEGRAM_BOT_TOKEN=
SERVICE_TELEGRAM_CHAT_ID=
SERVICE_TELEGRAM_PREVIEW=false
SERVICE_TELEGRAM_APP_URL=
