# Copy to .env (git-ignored). Local defaults work as-is except AUTH_SECRET_KEY.
# Generate: openssl rand -hex 32   — keep it with backups; the DB cannot be opened without it.
AUTH_SECRET_KEY=

# Where data/, backups/, sites/ live. Server: /srv/personal
PERSONAL_DIR=./.local
# memory-data clone with a built site/ (python3 apps/memory/build.py). Server: /srv/personal/memory
MEMORY_DATA_DIR=../../data/memory

# Local: my.localhost:8780. Server: MY_HOST=my.leneu.store, OLD_HOST=personal.leneu.store,
# MY_ORIGIN=https://my.leneu.store
MY_HOST=my.localhost
OLD_HOST=personal.localhost
MY_ORIGIN=http://my.localhost:8780
EDGE_PORT=8780
