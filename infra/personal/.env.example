# Copy to .env (git-ignored). Local defaults work as-is except AUTH_SECRET_KEY.
# Generate: openssl rand -hex 32   — keep it with backups; the DB cannot be opened without it.
AUTH_SECRET_KEY=

# Where data/, backups/, sites/ live. Server: /srv/personal
PERSONAL_DIR=./.local
# memory-data clone with a built site/ (python3 apps/memory/build.py). Server: /srv/personal/memory
MEMORY_DATA_DIR=../../data/memory

# Local: anotar.localhost:8780. Server: ANOTAR_HOST=anotar.leneu.store, OLD_HOST=personal.leneu.store,
# ANOTAR_ORIGIN=https://anotar.leneu.store
ANOTAR_HOST=anotar.localhost
OLD_HOST=personal.localhost
ANOTAR_ORIGIN=http://anotar.localhost:8780
EDGE_PORT=8780

# AI requests. Production mostly runs opencode free models (no auth file needed).
AI_RUNNER_KIND=opencode
AI_OPENCODE_ENABLED=true
AI_OPENCODE_MODEL=opencode/big-pickle
