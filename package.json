{
  "name": "leneu-storage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:oracle": "node scripts/dev-local-copy.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-offline-manifest.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:public": "node --env-file-if-exists=.env server/public.mjs",
    "test": "node --test test/*.test.mjs",
    "qa": "npm run build && node scripts/qa.mjs",
    "qa:task-board": "npm run build && node scripts/qa-task-board.mjs",
    "qa:ui": "npm run build && node scripts/qa-workspace-ui.mjs",
    "qa:share": "npm run build && node scripts/qa-share-itinerary.mjs",
    "qa:features": "npm run build && node scripts/qa-plan-page-preservation.mjs",
    "qa:google-map": "npm run build && node scripts/qa-google-itinerary.mjs",
    "qa:docker-share": "node scripts/qa-docker-share.mjs",
    "seed:showcase": "node scripts/seed-markdown-showcase.mjs",
    "seed:memo": "node scripts/seed-memo-samples.mjs",
    "seed:itinerary": "node scripts/seed-itinerary-sample.mjs",
    "seed:plan": "node scripts/seed-connected-itinerary.mjs",
    "seed:google-map": "node scripts/seed-google-itinerary.mjs",
    "backup": "node scripts/backup-data.mjs",
    "format": "prettier --write src server scripts vite.config.ts index.html",
    "seed:activity-plan": "node scripts/seed-activity-plan.mjs",
    "qa:static-plan": "npm run build && node scripts/qa-static-itinerary.mjs",
    "migration:check": "node scripts/migration-check.mjs",
    "auth:setup": "node --env-file-if-exists=.env scripts/auth-setup.mjs",
    "qa:auth": "npm run build && node scripts/qa-private-auth.mjs",
    "start:sites": "node --env-file-if-exists=.env server/sites.mjs",
    "sites:import": "node --env-file-if-exists=.env scripts/host-site.mjs import"
  },
  "dependencies": {
    "@emoji-mart/data": "1.2.1",
    "busboy": "^1.6.0",
    "marked": "16.4.2",
    "prosemirror-history": "^1.5.0"
  },
  "devDependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/diagram-block": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "dompurify": "3.4.16",
    "lucide-react": "^0.468.0",
    "mermaid": "11.17.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "4.4.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
