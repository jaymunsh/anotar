     "textAlignment": "left",
     "level": 1,
     "isToggleable": false
    },
    "content": [
     {
      "type": "text",
      "text": "4. ",
      "styles": {}
     },
     {
      "type": "text",
      "text": "재사용할 기존 코드와 필요한 준비",
      "styles": {}
     }
    ],
    "children": []
   },
   {
    "id": "a7288997-82e5-4f42-9dec-8ff4ab5bd7d8",
    "type": "bulletListItem",
    "props": {
     "backgroundColor": "default",
     "textColor": "default",
     "textAlignment": "left"
    },
    "content": [
     {
      "type": "text",
      "text": "server/search.mjs",
      "styles": {
       "code": true
      }
     },
     {
      "type": "text",
      "text": ": 검색·페이지네이션. MCP 접근 범위를 SQL/조회 계약에 적용해야 한다. 전체 검색 후 결과만 숨기면 개수·발췌가 노출될 수 있다.",
      "styles": {}
     }
    ],
    "children": []
   },
